{
  "mcpServers": {
    "jcodemunch": {
      "type": "stdio",
      "command": "uvx",
      "args": ["--from", "git+https://github.com/jgravelle/jcodemunch-mcp", "jcodemunch-mcp"],
      "envFile": "${workspaceFolder}/.env.mcp.local",
      "env": {
        "JCODEMUNCH_MAX_FOLDER_FILES": "4000"
      }
    },
    "codacy": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@codacy/codacy-mcp@latest"],
      "envFile": "${workspaceFolder}/.env.mcp.local"
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"],
      "envFile": "${workspaceFolder}/.env.mcp.local"
    },
    "graphify": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "graphifyy[mcp]",
        "graphify-mcp",
        "${workspaceFolder}/graphify-out/graph.json"
      ]
    }
  }
}
