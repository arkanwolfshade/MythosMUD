; import-linter contracts encoding ADR-001's layer direction (Domain / Persistence must not
; reach up into Service), scoped to what #757's remediation actually fixed and verified clean.
;
; Verify: uv run lint-imports
;
; Scope note (#757): a full ADR-001 "layers" contract across all of server/ was evaluated and
; deliberately NOT written here. server/npc/ still has 11 lazy imports of server/services/
; (movement_integration.py x2, threading.py x2, spawning_service.py, spawning_instance_factory.py,
; npc_combat_schedule.py, idle_movement.py, npc_base.py, aggressive_mob_npc.py,
; passive_mob_npc.py), part of the explicitly out-of-scope "922 individually-hoistable lazy
; imports" population this remediation measured but did not touch.
;
; PR2 initially rewrote three of those (npc_base, aggressive_mob_npc, passive_mob_npc) to route
; through a server.main lookup helper, and that was REVERTED: importing server.main constructs
; the whole FastAPI app (+43 MB RSS, NATS state machines, background logging threads) inside any
; caller, which crashed pytest-xdist workers under coverage. The three edges are unenforced by
; the contracts below either way, so the honest fix for all 11 is dependency injection into
; NPCBase — a dedicated pass, not a lookup-helper indirection. Locking npc/ -> services/ waits
; on that.
;
; server/api/__init__.py <-> server/api/players.py and server/api/admin/__init__.py <->
; server/api/admin/npc.py are known, deliberate module-init side-effect-import cycles (route
; registration) — not covered by either contract below, so no exemption syntax is needed.

[importlinter]
root_package = server
exclude_type_checking_imports = True

[importlinter:contract:domain-layer-direction]
name = ADR-001: Domain layer (models/, events/) must not import Service (game/, services/, npc/) or Persistence
type = forbidden
source_modules =
    server.models
    server.events
forbidden_modules =
    server.game
    server.services
    server.npc
    server.persistence

[importlinter:contract:persistence-layer-direction]
name = ADR-001: Persistence layer must not import Service (game/, services/, npc/)
type = forbidden
source_modules =
    server.persistence
forbidden_modules =
    server.game
    server.services
    server.npc
