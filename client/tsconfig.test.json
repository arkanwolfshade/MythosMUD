{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "declarationDir": "./node_modules/.tmp/types/test",
    "types": ["vitest/globals", "@testing-library/jest-dom/vitest", "node", "vite/client"],
    "noEmit": false,
    "emitDeclarationOnly": true
  },
  "include": [
    "src/**/__tests__/**/*",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/test/**/*",
    "tests/e2e/runtime/fixtures/message-match.ts",
    "tests/e2e/runtime/fixtures/server-logs.ts"
  ],
  "exclude": [],
  "references": [{ "path": "./tsconfig.app.json" }]
}
