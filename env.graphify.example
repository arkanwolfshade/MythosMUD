# Graphify LLM credentials (example — copy to .env.graphify.local)
#
#   Copy-Item env.graphify.example .env.graphify.local
#   # edit .env.graphify.local with your real key
#   . .\scripts\load_graphify_env.ps1
#   graphify extract ...
#
# Also set as a Windows User environment variable for new terminals:
#   [Environment]::SetEnvironmentVariable('GEMINI_API_KEY', '...', 'User')
#
# Get a key: https://aistudio.google.com/apikey
# Never commit .env.graphify.local

GEMINI_API_KEY=
GOOGLE_API_KEY=
